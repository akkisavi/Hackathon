# Copy to .env and fill in. Never commit the real .env.

# NASA FIRMS — register free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Postgres/PostGIS (matches docker-compose service "db")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firedetect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firedetect

# Redis (Celery broker/backend)
# Local docker: redis://localhost:6379/0
# Upstash (TLS): rediss://default:<password>@<host>.upstash.io:6379?ssl_cert_reqs=required
REDIS_URL=redis://localhost:6379/0

# LLM for narrative generation + NL query (OpenAI-compatible endpoint).
# Default = Google Gemini (free key: https://aistudio.google.com/apikey).
# To use NVIDIA build instead, swap these three:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=mistralai/mistral-nemotron
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Google Earth Engine — ESA WorldCover land-cover sampling.
# Run `earthengine authenticate` once, then set your Cloud project id.
# Blank => land-cover enrichment is skipped, pipeline still runs.
GEE_PROJECT=

# Auth — JWT signing, API-key hashing, password-reset tokens.
# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is NO safe default for these in code — set them before running.
JWT_SECRET=
SESSION_SECRET=
API_KEY_PEPPER=
PASSWORD_RESET_EXPIRY=3600
FRONTEND_URL=http://localhost:5173

# SMTP (optional) — forgot-password + alert emails are silently skipped when unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Comma-separated emails to notify on new/unregistered thermal-source alerts.
# Blank => notifications disabled.
ALERT_NOTIFY_EMAILS=
