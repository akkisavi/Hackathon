# Copy to .env and fill in. Never commit the real .env.

# NASA FIRMS — register free at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Postgres/PostGIS (matches docker-compose service "db")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firedetect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=firedetect

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# LLM for narrative generation + NL query (OpenAI-compatible endpoint).
# Default = Google Gemini (free key: https://aistudio.google.com/apikey).
# To use NVIDIA build instead, swap these three:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=mistralai/mistral-nemotron
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Google Earth Engine — ESA WorldCover land-cover sampling.
# Run `earthengine authenticate` once, then set your Cloud project id.
# Blank => land-cover enrichment is skipped, pipeline still runs.
GEE_PROJECT=
